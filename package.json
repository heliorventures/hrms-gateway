{
  "name": "kabipay-gateway",
  "version": "1.0.0",
  "description": "Schema-stitching GraphQL gateway for KabiPay Rust subgraphs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "tsx --test src/**/*.test.ts",
    "build": "tsc",
    "security:audit": "npm audit --package-lock-only --include=dev --audit-level=low"
  },
  "dependencies": {
    "@graphql-tools/executor-http": "^3.6.0",
    "@graphql-tools/stitch": "^10.4.2",
    "@graphql-tools/utils": "^12.1.0",
    "@graphql-tools/wrap": "^11.2.4",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
