# Base URL for subgraph introspection (no trailing slash). Each service serves `/graphql`
# on its port (see STATUS.md). Default is fine for local `cargo run` on Windows.
KABIPAY_SUBGRAPH_BASE_URL=http://127.0.0.1

# Gateway port — the UI should point at this URL:
#   http://127.0.0.1:4009/graphql
KABIPAY_GATEWAY_PORT=4009
